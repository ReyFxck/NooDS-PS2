# NooDS-PS2 - PS2SDK build
#
# Stage 1: build the PS2 bootstrap plus the complete 2021 NooDS core.
# The bootstrap does not instantiate Core yet; linking every core object here
# catches toolchain/libstdc++/pthread incompatibilities early.

ifeq ($(strip $(PS2SDK)),)
$(error PS2SDK is not set. Install ps2dev/ps2sdk and export PS2SDK)
endif

ifeq ($(strip $(GSKIT)),)
$(error GSKIT is not set. Install ps2dev/gsKit and export GSKIT)
endif

EE_TOOL_PREFIX ?= mips64r5900el-ps2-elf-
EE_CXX         ?= $(EE_TOOL_PREFIX)g++

# Stamp every PS2 binary with the exact source revision used by CI/local builds.
# The upstream base commit is intentionally kept separate in the runtime banner.
BUILD_REVISION ?= $(shell git rev-parse HEAD 2>/dev/null || echo unknown)
BUILD_STATE    ?= $(shell git diff-index --quiet HEAD -- 2>/dev/null && echo clean || echo dirty)

TARGET := noods-ps2.elf
BUILD  := build-ps2

CORE_SOURCES := \
	src/cartridge.cpp \
	src/core.cpp \
	src/cp15.cpp \
	src/div_sqrt.cpp \
	src/dldi.cpp \
	src/dma.cpp \
	src/gpu.cpp \
	src/gpu_2d.cpp \
	src/gpu_3d.cpp \
	src/gpu_3d_renderer.cpp \
	src/input.cpp \
	src/interpreter.cpp \
	src/ipc.cpp \
	src/memory.cpp \
	src/rtc.cpp \
	src/settings.cpp \
	src/spi.cpp \
	src/spu.cpp \
	src/timers.cpp \
	src/wifi.cpp

PS2_SOURCES := \
	src/ps2/main.cpp \
	src/ps2/ps2_file.cpp \
	src/ps2/arm_alu.cpp \
	src/ps2/r5900_code_cache.cpp \
	src/ps2/dynarec_r5900.cpp \
	src/ps2/present.cpp \
	src/ps2/vu1_g3d.cpp

SOURCES := $(PS2_SOURCES) $(CORE_SOURCES)
OBJECTS := $(patsubst src/%.cpp,$(BUILD)/%.o,$(SOURCES))
ALL_OBJECTS := $(OBJECTS)

DEBUG ?= 0
PROFILE ?= 0
PROFILE_LEVEL ?= 2
# How many cycles one CPU may run ahead of the other while executing native
# blocks (see src/core_budget.h). 0 keeps the original lockstep interleaving.
# Changing it needs a clean rebuild, e.g. make -f Makefile.ps2 clean all SYNC_QUANTUM=32
SYNC_QUANTUM ?= 0
# Presentation pacing (see src/ps2/present.cpp). "adaptive" skips the vsync wait
# when the emulator is already slower than the display; "vsync" always waits.
PRESENT ?= adaptive
# Parallel build jobs (default 4). Reduce if linking hits memory limits.
JOBS ?= 4

COMMON_FLAGS := -D_EE -DNOODS_PS2 -G0 -Wall -Wextra -std=gnu++11 \
                -fno-rtti -pipe \
                -DNOODS_BUILD_REVISION=\"$(BUILD_REVISION)\" \
                -DNOODS_BUILD_STATE=\"$(BUILD_STATE)\" \
                -DNOODS_SYNC_QUANTUM_DEFAULT=$(SYNC_QUANTUM) \
                -I$(PS2SDK)/ee/include -I$(PS2SDK)/common/include -I$(PS2SDK)/ports/include -I$(GSKIT)/include -Isrc

ifeq ($(PRESENT),vsync)
COMMON_FLAGS += -DNOODS_PS2_PRESENT_VSYNC_ALWAYS
endif

ifeq ($(PROFILE),1)
COMMON_FLAGS += -DNOODS_PROFILE -DNOODS_PROFILE_LEVEL=$(PROFILE_LEVEL)
else
COMMON_FLAGS += -DNOODS_PROFILE_LEVEL=0
endif

ifeq ($(DEBUG),1)
OPT_FLAGS := -Og -gdwarf-2 -DDEBUG
else
ifeq ($(PROFILE),1)
OPT_FLAGS := -O3 -flto -fomit-frame-pointer
else
OPT_FLAGS := -O3 -flto -fomit-frame-pointer
endif
endif

CXXFLAGS := $(COMMON_FLAGS) $(OPT_FLAGS)
LDFLAGS  := -T$(PS2SDK)/ee/startup/linkfile -L$(PS2SDK)/ee/lib -L$(PS2SDK)/ports/lib -L$(GSKIT)/lib -Wl,-zmax-page-size=128 -flto

# NooDS 2021 uses std::thread/mutex/condition_variable in GPU/SPU paths.
# PS2SDK supplies pthread + pthreadglue; keep them in a group with libstdc++
# because all of these libraries are static in the PS2 toolchain.
LIBS := -Wl,--start-group -lgskit -ldmakit -lpad -lps2_drivers -lfileXio -lpatches -lstdc++ -latomic -ldebug -lm -lc -lcglue -lpthread -lpthreadglue -lkernel -Wl,--end-group

.PHONY: all clean debug profile info

all: $(TARGET)

$(TARGET): $(ALL_OBJECTS)
	$(EE_CXX) $(OPT_FLAGS) -flto -o $@ $^ $(LDFLAGS) $(LIBS)
	@echo "Built $@"

$(BUILD)/%.o: src/%.cpp
	@mkdir -p $(dir $@)
	$(EE_CXX) $(CXXFLAGS) -c $< -o $@

# Parallel build helper - use 'make -j$(JOBS) -f Makefile.ps2' to build with JOBS parallel jobs
# The -pipe flag in COMMON_FLAGS reduces temporary file I/O and memory usage.
# For memory-constrained systems, try: make -f Makefile.ps2 JOBS=2

debug:
	$(MAKE) -f Makefile.ps2 DEBUG=1 clean all

profile:
	$(MAKE) -f Makefile.ps2 PROFILE=1 DEBUG=0 clean all

info:
	@echo "PS2SDK=$(PS2SDK)"
	@echo "EE_CXX=$(EE_CXX)"
	@echo "TARGET=$(TARGET)"
	@echo "BUILD_REVISION=$(BUILD_REVISION) ($(BUILD_STATE))"
	@echo "PROFILE=$(PROFILE) PROFILE_LEVEL=$(PROFILE_LEVEL)"
	@echo "Core sources: $(words $(CORE_SOURCES))"
	@echo "PS2 sources: $(words $(PS2_SOURCES))"

clean:
	rm -rf $(BUILD) $(TARGET)
